# --- Database ---
# REQUIRED: Set to your production PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=""

# --- Redis / Queue ---
# REQUIRED: Set to your production Redis connection string
# Format: redis://:password@host:port
REDIS_URL=""

# --- Auth ---
# REQUIRED: Generate a strong random secret (min 32 chars)
# Use: openssl rand -base64 32
# DO NOT use the default value in production!
JWT_SECRET=""

# Token expiry (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN="1h"

# Bcrypt rounds (12 recommended for production)
BCRYPT_ROUNDS="12"

# --- Queue ---
QUEUE_NAME="scan-queue"
MAX_CONCURRENT_JOBS="5"

# --- Scanner ---
SCAN_TIMEOUT_MS="10000"
SCAN_MAX_RETRIES="2"
SCAN_RETRY_DELAY_MS="1000"

# --- App ---
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="LeadGuard"
LOG_LEVEL="info"
# LOG_DIR="./logs"

# --- CORS (comma separated origins; restrict in production) ---
# REQUIRED: Set to your frontend domain(s), e.g. "https://app.example.com,https://admin.example.com"
# DO NOT use "*" in production!
CORS_ORIGINS=""

# --- Monitoring alerts (optional; email alerts need SMTP) ---
# MONITOR_SWEEP_CRON="*/15 * * * *"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# ALERT_FROM_EMAIL="LeadGuard <alerts@yourdomain.com>"
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15551234567"

# --- Seed (optional; run `npx prisma db seed`) ---
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""  # Generate strong password, do not use default
# ADMIN_NAME="Admin"

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
ALERT_FROM_EMAIL="LeadGuard <onboarding@resend.dev>"

# Google Gemini AI fix suggestions (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI AI fix suggestions (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Monitor sweeper cron (default every 5 min)
MONITOR_SWEEP_CRON=*/5 * * * *

# Internal alert webhook (optional, for critical system alerts)
INTERNAL_ALERT_WEBHOOK=

# Telegram bot for alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Optional Redis connection fields when REDIS_URL is not used
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Chromium path for screenshots (container-specific)
CHROMIUM_PATH=/usr/bin/chromium