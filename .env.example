# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/leadguard?schema=public"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
BCRYPT_ROUNDS="10"

# --- Queue ---
QUEUE_NAME="scan-queue"
MAX_CONCURRENT_JOBS="5"

# --- Scanner ---
SCAN_TIMEOUT_MS="10000"
SCAN_MAX_RETRIES="2"
SCAN_RETRY_DELAY_MS="1000"

# --- App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="LeadGuard"
LOG_LEVEL="debug"
# LOG_DIR="./logs"

# --- CORS (comma separated origins; * for all) ---
CORS_ORIGINS="*"

# --- Monitoring alerts (optional; email alerts need SMTP) ---
# MONITOR_SWEEP_CRON="*/15 * * * *"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# ALERT_FROM_EMAIL="LeadGuard <alerts@yourdomain.com>"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15551234567"

# --- Seed (optional; run `npx prisma db seed`) ---
ADMIN_EMAIL="admin@leadguard.app"
ADMIN_PASSWORD="admin-password-change-me"
ADMIN_NAME="Admin"

# Resend transactional email (https://resend.com) — alerts ke liye
RESEND_API_KEY=
ALERT_FROM_EMAIL=LeadGuard <onboarding@resend.dev>

# Google Gemini AI fix suggestions (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# gemini-3-flash-preview recommended; check available models if 404/429
GEMINI_MODEL=gemini-3-flash-preview

# Monitor sweeper cron (default every 5 min)
MONITOR_SWEEP_CRON=*/5 * * * *

# Optional Redis connection fields when REDIS_URL is not used
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
